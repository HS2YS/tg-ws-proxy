# Required: public IPv4 address or DNS name of the VPS, without a scheme.
TG_WS_PROXY_PUBLIC_HOST=

# Public TCP port on the VPS. The container always listens on port 1443.
TG_WS_PROXY_PUBLIC_PORT=1443

# Required: exactly 32 hexadecimal characters.
# Generate once with: openssl rand -hex 16
TG_WS_PROXY_SECRET=

# Address on the VPS where Docker publishes the port.
TG_WS_PROXY_BIND_IP=0.0.0.0

# Telegram datacenter overrides, separated by spaces.
TG_WS_PROXY_DC_IPS=2:149.154.167.220 4:149.154.167.220

# Cloudflare Worker domains, separated by spaces, commas, or semicolons.
TG_WS_PROXY_CF_WORKER=

# Custom Cloudflare-proxied domains, separated the same way.
TG_WS_PROXY_CF_PROXY_DOMAINS=

# Disable the automatic Cloudflare fallback.
TG_WS_PROXY_NO_CF_PROXY=false

# SNI domain for Fake TLS masking.
TG_WS_PROXY_FAKE_TLS_DOMAIN=

# Enable only when an nginx/HAProxy frontend sends PROXY protocol v1.
TG_WS_PROXY_PROXY_PROTOCOL=false

# Route all traffic to Telegram test datacenters.
TG_WS_PROXY_FORCE_TEST_DC=false

# Enable DEBUG logs.
TG_WS_PROXY_VERBOSE=false

# Socket buffer size in KiB and prepared connections per datacenter.
TG_WS_PROXY_BUF_KB=256
TG_WS_PROXY_POOL_SIZE=4
